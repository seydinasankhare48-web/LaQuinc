# Copier vers .env puis renseigner. Ne jamais committer .env.

# Supabase (valeurs locales : `supabase status`) — connexion côté client seulement
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Base : l'API utilise le rôle laquinc_app (sans BYPASSRLS) ; les migrations utilisent laquinc_migrator
DATABASE_URL=
DATABASE_MIGRATOR_URL=
# Rôle administrateur, utilisé par `pnpm db:bootstrap` uniquement (création des rôles)
DATABASE_ADMIN_URL=
# Mots de passe des rôles, utilisés par le script de bootstrap uniquement
LAQUINC_APP_PASSWORD=
LAQUINC_MIGRATOR_PASSWORD=
LAQUINC_STATS_PASSWORD=

# Tests (docker compose : postgres-test)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:54330/laquinc_test

REDIS_URL=
# Clé maîtresse de chiffrement des clés API des quincailleries (hors base)
ENCRYPTION_MASTER_KEY=
