{
  "name": "laquinc",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:bootstrap": "pnpm --filter @laquinc/db db:bootstrap",
    "db:migrate": "pnpm --filter @laquinc/db db:migrate",
    "e2e:build": "pnpm --filter @laquinc/api build && NEXT_PUBLIC_SUPABASE_URL=http://localhost:54399 NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=e2e-publishable-key NEXT_PUBLIC_API_URL=http://localhost:3101 pnpm --filter @laquinc/web build",
    "e2e": "pnpm e2e:build && pnpm --filter @laquinc/e2e e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@laquinc/config": "workspace:*",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "supabase": "^2.121.0",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
